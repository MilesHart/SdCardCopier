# Destination for copied files (used when -d is not passed)
DESTINATION_PATH=\\your\path\here

# Pi deploy (for deploy-to-pi.ps1). Add to .env for password auth; install sshpass for automation.
PI_HOST=192.168.1.251
PI_USER=pi
PI_PASS=your_password

# Telegram notifications (optional). Copy to .env and fill in your values.
# Get the bot token from @BotFather. Get your chat ID: message the bot, then run SDCardImporter --telegram-get-chat-id
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Web UI (with --web). When set, included in "card detected" Telegram for remote monitoring.
# Example for Pi: http://192.168.1.251:5050/
WEB_URL=

# Web UI (with --web). When set, included in "card detected" Telegram messages for remote monitoring.
# Example for Pi at 192.168.1.251: WEB_URL=http://192.168.1.251:5050/
WEB_URL=

# Web UI (with --web). When set, included in "card detected" Telegram for remote monitoring.
# Example for Pi at 192.168.1.251: http://192.168.1.251:5050/
WEB_URL=

# Web UI (with --web). When set, included in "card detected" Telegram messages for remote monitoring.
# Example for Pi at 192.168.1.251: http://192.168.1.251:5050/
WEB_URL=
